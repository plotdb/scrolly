#!/usr/bin/env bash
# build src/index.js -> dist/index.js (readable) + dist/index.min.js (minified),
# then vendor dist into the demo site so web/ can load it like any fedep lib.
set -e
rm -rf dist
mkdir -p dist
echo "copy src/index.js -> dist/index.js ..."
cp src/index.js dist/index.js
echo "minifying -> dist/index.min.js ..."
./node_modules/.bin/uglifyjs dist/index.js -m -c > dist/index.min.js
echo "copy dist -> web/static/assets/lib/@plotdb/scrolly/main ..."
rm -rf "web/static/assets/lib/@plotdb/scrolly/main"
mkdir -p "web/static/assets/lib/@plotdb/scrolly/main"
cp -R dist/* "web/static/assets/lib/@plotdb/scrolly/main"
echo "done."
