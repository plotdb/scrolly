doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title @plotdb/scrolly — demo
    +script([{name:'d3', path:'d3.min.js'}, {name:'@plotdb/scrolly'}])
    style.
      :root{--bg:#f7f8fa;--panel:#fff;--line:#e2e6ec;--fg:#1a1d24;--dim:#5a6272;--muted:#949bab;--accent:#1f6feb;--accent2:#0f9d76;--female:#e0447a}
      *{box-sizing:border-box}
      body{margin:0;background:var(--bg);color:var(--fg);line-height:1.55;font-family:-apple-system,"Helvetica Neue",Arial,sans-serif}
      a{color:var(--accent)}
      .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
      .hero{padding:64px 0 30px;border-bottom:1px solid var(--line)}
      .hero h1{font-size:40px;letter-spacing:-1px;margin:0 0 10px}
      .hero code{background:#eef1f5;border:1px solid var(--line);border-radius:6px;padding:2px 8px;font-size:15px}
      .hero p{font-size:17px;color:var(--dim);max-width:640px}
      .scrolly{display:grid;grid-template-columns:minmax(0,380px) 1fr;gap:44px;align-items:stretch}
      .narrative{padding:14vh 0}
      .step{min-height:80vh;display:flex;flex-direction:column;justify-content:center}
      .step .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px 24px;box-shadow:0 4px 20px rgba(20,25,40,.06);opacity:.5;transform:translateY(8px);transition:.4s}
      .step.active .card{opacity:1;transform:none;box-shadow:0 8px 30px rgba(20,25,40,.09)}
      .step .kick{font-size:12px;color:var(--accent);font-weight:600;letter-spacing:.4px;margin-bottom:6px}
      .step h3{margin:0 0 8px;font-size:20px}
      .step p{margin:0;color:var(--dim);font-size:15.5px;line-height:1.7}
      .sticky{position:sticky;top:24px;height:calc(100vh - 48px)}
      #stage{position:relative;width:100%;height:100%;background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:0 4px 20px rgba(20,25,40,.05);overflow:hidden}
      .scene{position:absolute;inset:0;padding:22px;opacity:0;transition:opacity .5s;pointer-events:none;display:flex;flex-direction:column}
      .scene.on{opacity:1;pointer-events:auto}
      .scene .sh{font-size:16px;font-weight:700;margin:0 0 12px}
      .scene .host{flex:1;position:relative;min-height:0}
      svg .axis text{fill:var(--muted);font-size:11px}
      svg .axis line,svg .axis path{stroke:var(--line)}
      svg .grid line{stroke:var(--line);stroke-opacity:.8}
      .foot{border-top:1px solid var(--line);margin-top:40px;padding:24px 0 60px;color:var(--muted);font-size:13px}
      @media(max-width:860px){.scrolly{grid-template-columns:1fr;gap:0}.sticky{position:sticky;top:12px;height:56vh;order:-1}.narrative{padding:4vh 0}.step{min-height:66vh}}
  body
    main.wrap
      section.hero
        h1 @plotdb/scrolly
        p A tiny scrollytelling engine — #[code Scrolly.init()] wires steps to sticky scenes over a #[code data-scene] contract. Scroll to see it switch. Charts drawn with the bundled #[code Scrolly.chart] d3 helpers.

      section.scrolly
        .narrative
          .step(data-scene="line")
            .card
              .kick Scene · line
              h3 A line, drawing itself in
              p Each #[code .step] carries a #[code data-scene]. As it reaches mid-viewport, the engine shows the matching #[code .scene] and calls your #[code onStep].
          .step(data-scene="line" data-phase="peak")
            .card
              .kick data-phase="peak"
              h3 Same scene, different phase
              p Several steps can share one scene and pass a #[code data-phase] to request a variant — here, annotating the peak.
          .step(data-scene="bar")
            .card
              .kick Scene · bar
              h3 Switch to another visual
              p A different #[code data-scene] swaps the sticky graphic entirely. Any chart works — the engine only cares about the markup contract.
          .step(data-scene="bar" data-phase="hi")
            .card
              .kick data-phase="hi"
              h3 Highlight on cue
              p Drive emphasis from the narrative: this phase pulls one bar forward.

        .sticky
          #stage
            .scene(data-scene="line")
              .sh Annual value
              .host#lineHost
            .scene(data-scene="bar")
              .sh By category
              .host#barHost

      footer.foot
        div @plotdb/scrolly · MIT · #[a(href="https://github.com/plotdb/scrolly") github.com/plotdb/scrolly]

    script(type="module").
      const {frame,grid,axisX,axisY,drawIn}=Scrolly.chart;
      const el=id=>document.getElementById(id);
      const SERIES=[{y:2016,v:42},{y:2017,v:48},{y:2018,v:61},{y:2019,v:78},{y:2020,v:71},{y:2021,v:83},{y:2022,v:97},{y:2023,v:110},{y:2024,v:104}];
      const peak=SERIES.reduce((a,b)=>b.v>a.v?b:a);
      const CATS=[{k:'North',v:110},{k:'Central',v:74},{k:'South',v:88},{k:'East',v:31},{k:'Islands',v:12}];
      const topCat=CATS.reduce((a,b)=>b.v>a.v?b:a);

      const DRAW={};
      DRAW.line=(phase)=>{
        const {svg,W,H,M}=frame(el('lineHost'),{t:20,r:22,b:28,l:44});
        const x=d3.scalePoint().domain(SERIES.map(d=>d.y)).range([M.l,W-M.r]).padding(.4);
        const y=d3.scaleLinear().domain([0,d3.max(SERIES,d=>d.v)*1.12]).range([H-M.b,M.t]);
        grid(svg,y,M,W); axisX(svg,x,H,M); axisY(svg,y,M);
        drawIn(svg.append('path').datum(SERIES).attr('fill','none').attr('stroke','var(--accent)').attr('stroke-width',2.6).attr('d',d3.line().x(d=>x(d.y)).y(d=>y(d.v)).curve(d3.curveMonotoneX)));
        svg.append('g').selectAll('circle').data(SERIES).join('circle').attr('cx',d=>x(d.y)).attr('cy',d=>y(d.v)).attr('r',3).attr('fill','var(--accent)');
        if(phase==='peak'){
          svg.append('circle').attr('cx',x(peak.y)).attr('cy',y(peak.v)).attr('r',6).attr('fill','none').attr('stroke','var(--female)').attr('stroke-width',2);
          svg.append('text').attr('x',x(peak.y)).attr('y',y(peak.v)-12).attr('text-anchor','middle').attr('font-size',12).attr('font-weight',700).attr('fill','var(--female)').text('peak '+peak.v);
        }
      };
      DRAW.bar=(phase)=>{
        const {svg,W,H,M}=frame(el('barHost'),{t:14,r:26,b:26,l:74});
        const x=d3.scaleLinear().domain([0,d3.max(CATS,d=>d.v)*1.05]).range([M.l,W-M.r]);
        const y=d3.scaleBand().domain(CATS.map(d=>d.k)).range([M.t,H-M.b]).padding(.3);
        axisX(svg,x,H,M);
        svg.append('g').selectAll('text').data(CATS).join('text').attr('x',M.l-8).attr('y',d=>y(d.k)+y.bandwidth()/2).attr('text-anchor','end').attr('dominant-baseline','middle').attr('font-size',12).attr('fill','var(--dim)').text(d=>d.k);
        svg.append('g').selectAll('rect').data(CATS).join('rect').attr('x',M.l).attr('y',d=>y(d.k)).attr('height',y.bandwidth()).attr('rx',3)
          .attr('fill',d=>phase==='hi'?(d.k===topCat.k?'var(--accent)':'#c9d6ea'):'var(--accent)')
          .attr('width',0).transition().duration(650).ease(d3.easeCubicOut).attr('width',d=>x(d.v)-M.l);
      };

      Scrolly.init({onStep:(scene,phase)=>{DRAW[scene]&&DRAW[scene](phase);}});
